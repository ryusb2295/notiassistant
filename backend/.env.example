# 키는 하나만 넣으면 된다. 없으면 규칙 기반 분석만 동작한다.

# GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini는 위 두 값에 Gemini 키와 gemini-3.5-flash-lite를 넣고 아래 주소를 함께 쓴다.
# 무료 한도를 넘지 않도록 CRAWL_DELAY_SEC도 5로 올린다.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 행정실 화면을 쓸 아이디. 쉼표로 구분한다. 내 정보에 관리자, 담당자로 표시된다.
ADMIN_USERNAMES=
STAFF_USERNAMES=

# 0이면 주기 수집을 끈다. 분 단위.
CRAWL_INTERVAL_MIN=60
CRAWL_DELAY_SEC=1.0
